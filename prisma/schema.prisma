generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserAuth {
  auth_id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String       @unique @db.Uuid
  provider           AuthProvider
  provider_user_id   String?
  password_hash      String?
  created_at         DateTime     @default(now())
  hashedRefreshToken String?
  otp_expiry         DateTime?
  otp_hash           String?
  reset_token_expiry DateTime?
  reset_token_hash   String?
  users              User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "UserAuth_user_id_fkey")

  @@unique([provider, provider_user_id])
  @@map("user_auth")
}

model User {
  user_id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String       @unique
  username             String?      @unique
  firstname            String?
  lastname             String?
  phone                String?
  birthday             DateTime?    @db.Date
  point                Int          @default(0)
  total_cups_purchased Int          @default(0)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  member               Member_level @default(Bronze)
  addresses            Address[]
  favorites            Favorite[]
  orders               Order[]
  user_auth            UserAuth?
  user_rewards         UserReward[]

  @@map("users")
}

model Address {
  address_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  detail     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  name       String
  updated_at DateTime? @updatedAt @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("addresses")
}

model Branch {
  branch_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  detail    String

  @@map("branches")
}

model Banner {
  banner_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("banners")
}

model Reward {
  reward_id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image         String?
  name          String?
  require_point Int
  description   String?
  exp_date      DateTime?    @db.Date
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  user_rewards  UserReward[]

  @@map("rewards")
}

model UserReward {
  user_id       String       @db.Uuid
  reward_id     String       @db.Uuid
  created_at    DateTime     @default(now())
  expired_at    DateTime?
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reward_status RewardStatus @default(ACTIVE)
  used_at       DateTime?
  reward        Reward       @relation(fields: [reward_id], references: [reward_id])
  user          User         @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, reward_id])
  @@map("user_rewards")
}

model Menu {
  menu_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String?
  flavor     String        @unique
  rating     Float?        @default(0)
  created_at DateTime?     @default(now()) @db.Timestamp(6)
  discount   Int           @default(0) @db.SmallInt
  base_price Int           @default(0)
  favorites  Favorite[]
  variants   MenuVariant[]

  @@map("menus")
}

model MenuVariant {
  variant_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_id       String        @db.Uuid
  size          Size
  price_upsize  Int           @default(0)
  menu          Menu          @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade, onUpdate: NoAction)
  order_details OrderDetail[]

  @@unique([menu_id, size])
  @@map("menu_variants")
}

model Topping {
  topping_id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String               @unique
  price                 Int
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  order_detail_toppings OrderDetailTopping[]

  @@map("toppings")
}

model Order {
  order_id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String        @db.Uuid
  delivery      Boolean?      @default(false)
  total_price   Int
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  order_details OrderDetail[]
  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("orders")
}

model OrderDetail {
  order_detail_id       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String?              @db.Uuid
  quantity              Int
  sweetness             Sweetness?           @default(Sweet_100)
  price                 Int
  variant_id            String               @db.Uuid
  note                  String?
  order_detail_toppings OrderDetailTopping[]
  order                 Order?               @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  variant               MenuVariant          @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_details")
}

model OrderDetailTopping {
  order_detail_id String      @db.Uuid
  topping_id      String      @db.Uuid
  order_detail    OrderDetail @relation(fields: [order_detail_id], references: [order_detail_id], onDelete: Cascade, onUpdate: NoAction)
  topping         Topping     @relation(fields: [topping_id], references: [topping_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_detail_id, topping_id])
  @@map("order_detail_toppings")
}

model Favorite {
  user_id    String   @db.Uuid
  menu_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  menu       Menu     @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, menu_id])
  @@map("favorites")
}

enum Member_level {
  Bronze
  Silver
  Gold
}

enum Sweetness {
  Sweet_0
  Sweet_25
  Sweet_50
  Sweet_75
  Sweet_100
}

enum Size {
  S
  M
  L
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RewardStatus {
  ACTIVE
  USED
  EXPIRED
}
