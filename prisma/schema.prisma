generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id              String       @id @db.Uuid
  username             String?      @unique
  firstname            String?
  lastname             String?
  phone                String?
  birthday             DateTime?    @db.Date
  point                Int?         @default(0)
  pin                  Int?
  created_at           DateTime?    @default(now()) @db.Timestamp(6)
  updated_at           DateTime?    @default(now()) @updatedAt @db.Timestamp(6)
  total_cups_purchased Int          @default(0) @db.SmallInt
  addresses            Address[]
  favorites            Favorite[]
  member               Member?
  orders               Order[]
  user_rewards         UserReward[]

  @@map("users")
}

model Address {
  address_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  detail     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  name       String
  updated_at DateTime? @updatedAt @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("addresses")
}

model Branch {
  branch_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  detail    String

  @@map("branches")
}

model Banner {
  banner_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("banners")
}

model Reward {
  reward_id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image         String?
  name          String?
  require_point Int
  description   String?
  exp_date      DateTime?    @db.Date
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  user_rewards  UserReward[]

  @@map("rewards")
}

model UserReward {
  user_id   String @db.Uuid
  reward_id String @db.Uuid
  reward    Reward @relation(fields: [reward_id], references: [reward_id], onDelete: Cascade, onUpdate: NoAction)
  user      User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, reward_id])
  @@map("user_rewards")
}

model Member {
  member_id  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String       @unique @db.Uuid
  start_date DateTime?    @db.Date
  exp_date   DateTime?    @db.Date
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  level      Member_level @default(Bronze)
  user       User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("members")
}

model Menu {
  menu_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String?
  flavor     String        @unique
  rating     Float?        @default(0)
  created_at DateTime?     @default(now()) @db.Timestamp(6)
  discount   Int           @default(0) @db.SmallInt
  base_price Int           @default(0)
  favorites  Favorite[]
  variants   MenuVariant[]

  @@map("menus")
}

model MenuVariant {
  variant_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_id       String        @db.Uuid
  size          Size
  price_upsize  Int           @default(0)
  menu          Menu          @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade, onUpdate: NoAction)
  order_details OrderDetail[]

  @@unique([menu_id, size])
  @@map("menu_variants")
}

model Topping {
  topping_id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String               @unique
  price                 Int
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  order_detail_toppings OrderDetailTopping[]

  @@map("toppings")
}

model Order {
  order_id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String        @db.Uuid
  delivery      Boolean?      @default(false)
  total_price   Int?
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  order_details OrderDetail[]
  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("orders")
}

model OrderDetail {
  order_detail_id       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String?              @db.Uuid
  quantity              Int
  sweetness             Sweetness?           @default(Sweet_100)
  price                 Int
  variant_id            String?              @db.Uuid
  note                  String?
  order_detail_toppings OrderDetailTopping[]
  order                 Order?               @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  variant               MenuVariant?         @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_details")
}

model OrderDetailTopping {
  order_detail_id String      @db.Uuid
  topping_id      String      @db.Uuid
  order_detail    OrderDetail @relation(fields: [order_detail_id], references: [order_detail_id], onDelete: Cascade, onUpdate: NoAction)
  topping         Topping     @relation(fields: [topping_id], references: [topping_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_detail_id, topping_id])
  @@map("order_detail_toppings")
}

model Favorite {
  user_id    String   @db.Uuid
  menu_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  menu       Menu     @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, menu_id])
  @@map("favorites")
}

enum Member_level {
  Bronze
  Silver
  Gold
}

enum Sweetness {
  Sweet_0
  Sweet_25
  Sweet_50
  Sweet_75
  Sweet_100
}

enum Size {
  S
  M
  L
}
